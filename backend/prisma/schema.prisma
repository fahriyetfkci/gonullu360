generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VOLUNTEER
}

enum EventType {
  IN_PERSON
  ONLINE
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  ARCHIVED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users     User[]
  auditLogs AuditLog[]
  forms     Form[]
  events    Event[]
  eventGroups EventGroup[]
  volunteers Volunteer[]
  applications Application[]
  notifications Notification[]
}

model User {
  id                  String    @id @default(cuid())
  orgId               String
  email               String
  name                String    @default("Yönetici")
  passwordHash        String
  phone               String?
  jobTitle            String?
  about               String?
  address             String?
  website             String?
  photo               String?
  role                Role      @default(VOLUNTEER)
  isVerified          Boolean   @default(false)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  backupCodesHash     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  notifications Notification[]
  managerNotesAuthored VolunteerProfile[] @relation("ManagerNoteAuthor")
  sessions         RefreshSession[]
  auditLogs        AuditLog[]
  createdForms     Form[]           @relation("FormCreatedBy")
  publishedVersions FormVersion[]   @relation("FormVersionPublishedBy")
  createdEvents     Event[]          @relation("EventCreatedBy")

  @@unique([orgId, email])
  @@index([orgId])
}

model RefreshSession {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  deviceInfo        String?
  ipAddress         String
  userAgent         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  action    String
  ipAddress String
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Form {
  id               String    @id @default(cuid())
  orgId            String
  clientFormId     String
  title            String
  description      String?
  draftSchema      Json
  draftRevision    Int       @default(1)
  publishedVersion Int       @default(0)
  publishedAt      DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  versions     FormVersion[]
  registrationEvents Event[]        @relation("EventRegistrationForm")
  submissions FormSubmission[]

  @@unique([orgId, clientFormId])
  @@index([orgId, updatedAt])
}

model Event {
  id                 String      @id @default(cuid())
  orgId              String
  createdById        String?
  registrationFormId String?
  name               String
  slug               String
  type               EventType
  status             EventStatus @default(SCHEDULED)
  startsAt           DateTime
  endsAt             DateTime
  timezone           String      @default("Europe/Istanbul")
  address            String?
  capacity           Int?
  contactInfo        String?
  description        String?
  posterUrl          String?
  posterStorageKey   String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  registrationForm Form?        @relation("EventRegistrationForm", fields: [registrationFormId], references: [id], onDelete: SetNull)
  groups           EventGroupAssignment[]
  participants     EventParticipant[]

  @@unique([orgId, slug])
  @@index([orgId, startsAt])
  @@index([orgId, status, startsAt])
  @@index([registrationFormId])
}

model EventGroup {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  color       String
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events       EventGroupAssignment[]

  @@unique([orgId, name])
  @@index([orgId, name])
}

model EventGroupAssignment {
  eventId String
  groupId String

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group EventGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([eventId, groupId])
  @@index([groupId])
}

model FormVersion {
  id            String   @id @default(cuid())
  formId        String
  version       Int
  schema        Json
  publishedById String?
  publishedAt   DateTime @default(now())

  form        Form  @relation(fields: [formId], references: [id], onDelete: Cascade)
  publishedBy User? @relation("FormVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([formId, version])
  @@index([formId, publishedAt])
}

model FormSubmission {
  id String @id @default(cuid())
  formId String
  formVersion Int
  answers Json
  submittedAt DateTime @default(now())
  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  files FormSubmissionFile[]
  @@index([formId, submittedAt])
}

model FormSubmissionFile {
  id String @id @default(cuid())
  submissionId String
  fieldId String
  originalName String
  content Bytes
  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  @@index([submissionId])
}


model Volunteer {
  id             Int      @id @default(autoincrement())
  organizationId String   @map("organization_id")
  name           String
  city           String
  gender         String
  age            Int
  education      String   @default("Üniversite")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  profile      VolunteerProfile?
  interests    VolunteerInterest[]
  educations   VolunteerEducation[]
  participants EventParticipant[]
  organization Organization         @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
  @@index([city])
  @@index([active, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, city])
  @@index([organizationId, gender])
  @@index([organizationId, age])
  @@index([organizationId, active, createdAt])
  @@map("volunteers")
}


model Application {
  id             Int          @id @default(autoincrement())
  organizationId String       @map("organization_id")
  name           String
  city           String
  gender         String
  age            Int
  education      String       @default("Üniversite")
  status         String       @default("İşlem Bekliyor")
  phone          String?
  email          String?
  address        String?
  interests      String?
  coverLetter    String?      @map("cover_letter")
  evaluationNote String?      @map("evaluation_note")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([city])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, city])
  @@map("applications")
}


model VolunteerProfile {
  volunteerId          Int       @id @map("volunteer_id")
  volunteerCode        String?   @unique @map("volunteer_code")
  birthDate            DateTime? @map("birth_date") @db.Date
  department           String?
  phone                String?
  email                String?
  address              String?
  photoUrl             String?   @map("photo_url")
  managerNote          String?   @map("manager_note")
  coverLetter          String?   @map("cover_letter")
  volunteeringTarget   Int       @default(80) @map("volunteering_target")
  participationTarget  Int       @default(70) @map("participation_target")
  managerNoteAuthorId  String?   @map("manager_note_author_id")
  managerNoteUpdatedAt DateTime? @map("manager_note_updated_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  volunteer         Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  managerNoteAuthor User?     @relation("ManagerNoteAuthor", fields: [managerNoteAuthorId], references: [id], onDelete: SetNull)

  @@map("volunteer_profiles")
}


model VolunteerInterest {
  volunteerId Int    @map("volunteer_id")
  interest    String

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@id([volunteerId, interest])
  @@index([interest])
  @@map("volunteer_interests")
}


model VolunteerEducation {
  id          Int     @id @default(autoincrement())
  volunteerId Int     @map("volunteer_id")
  level       String
  school      String
  department  String?
  startYear   Int?    @map("start_year")
  endYear     Int?    @map("end_year")
  current     Boolean @default(false)

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId, current])
  @@map("volunteer_educations")
}


model Notification {
  id             Int      @id @default(autoincrement())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  message        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, read, createdAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}


model EventParticipant {
  id          Int @id @default(autoincrement())
  volunteerId Int @map("volunteer_id")
  eventId     String @map("event_id")

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, eventId])
  @@index([volunteerId])
  @@index([eventId])
  @@map("event_participants")
}
